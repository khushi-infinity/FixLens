<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build overlay: allow cleartext HTTP to the local development
     backend (adb reverse / LAN IP). Release builds keep the platform default
     (HTTPS only) because this overlay applies to debug variants only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
