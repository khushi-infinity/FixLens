# FixLens backend configuration — copy to backend/.env and fill in.
# backend/.env is git-ignored; NEVER commit real keys.

# --- AI provider keys (server-side only; never in the Android app) ---
GEMINI_API_KEY=PASTE_KEY_HERE
OPENROUTER_API_KEY=PASTE_KEY_HERE

# --- Provider selection ---
# Primary provider: gemini | openrouter
AI_PROVIDER=gemini
# Used only when the primary is unavailable (timeout/5xx/quota/network).
# Leave empty to disable fallback.
AI_FALLBACK_PROVIDER=openrouter

# --- Model configuration (optional; sensible defaults built in) ---
# Comma-separated candidates: the first model that answers wins.
# Verified against this project's key during Phase 2 bring-up:
#   gemini-flash-latest            -> WORKING (default primary candidate)
#   gemini-3.8-flash/3.5-flash     -> 503 overload at the time
#   gemini-2.5-flash*              -> 404 (not enabled for that key)
#GEMINI_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash
#
# OpenRouter free vision models (candidates tried in order; free pools are
# per-model, so a saturated candidate falls through to the next):
#OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# --- Request limits ---
#DIAGNOSE_TIMEOUT_SECONDS=75
